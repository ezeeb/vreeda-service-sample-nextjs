# Application Configuration
NODE_ENV=development
NEXTAUTH_URL=https://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# Azure AD B2C Configuration
AZURE_AD_B2C_TENANT_NAME=vreedaid
AZURE_AD_B2C_CLIENT_ID=your-client-id
AZURE_AD_B2C_CLIENT_SECRET=your-client-secret
AZURE_AD_B2C_PRIMARY_USER_FLOW=B2C_1A_VREELI_SERVICE_SIGNIN_PROD

# OAuth2/ConsentService Configuration
OAUTH2_CLIENT_ID=${AZURE_AD_B2C_CLIENT_ID}
OAUTH2_CLIENT_SECRET=${AZURE_AD_B2C_CLIENT_SECRET}
OAUTH2_CONSENT_SERVICE_URL=https://consent.dev.api.vreeda.com
OAUTH2_REDIRECT_URI=https://localhost:3000/api/consent/callback
OAUTH2_SCOPES=devices:read devices:control offline_access

# WebView Audience (Client IDs accepted for WebView Bearer tokens, comma-separated)
WEB_VIEW_AUDIENCE=your-app-client-id

# Vreeda API Configuration
VREEDA_API_BASEURL=https://client-rest.api.vreeda.com

# Database Configuration
MONGODB_URI=mongodb://root:example@localhost:27017/sample-service

# Job API Key (shared by all Kubernetes CronJobs)
API_JOBS_KEY=your-secure-job-key
